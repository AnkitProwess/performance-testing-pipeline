{
    "apiName": "<Your API Name>",
    "artifact_version": "1.0.0",
    "authType": "CLIENT_ID_ENFORCEMENT",
    "authParameters": {
        "clientId": "{{CLIENT_ID}}",
        "clientSecret": "{{CLIENT_SECRET}}"
    },
    "stages": [
        {
            "duration": "10s",
            "target": 15
        },
        {
            "duration": "20s",
            "target": 25
        },
        {
            "duration": "10s",
            "target": 1
        }
    ],
    "thresholds": {
        "http_req_failed": [
            "rate<0.005"
        ],
        "http_req_duration": [
            "p(90)<500",
            "p(95)<1000",
            "p(99)<2000"
        ]
    },
    "endpoints": [
        {
            "endpoint": "https://<your-api-host>/api/orders/ORD102",
            "method": "GET",
            "expectedStatus": 200,
            "sleepDuration": 0.5
        },
        {
            "endpoint": "https://<your-api-host>/api/orders/ORD113",
            "method": "PUT",
            "payload": {
                "address": "Hyderabad",
                "quantity": 2
            },
            "expectedStatus": 200,
            "sleepDuration": 0.5
        }
    ]
}
